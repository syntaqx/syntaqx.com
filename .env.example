# Copy to .env.local. Every variable is optional.

# Rate limiting (/docs/requests/rate-limiting). Without Redis the limiter uses the `noop`
# store: headers are sent, nothing is ever blocked.
#
# Local Redis from compose.yml (`docker compose up -d`):
# UPSTASH_REDIS_REST_URL=http://localhost:8079
# UPSTASH_REDIS_REST_TOKEN=local_dev_token
#
# On Vercel, the Upstash Marketplace integration sets KV_REST_API_URL and
# KV_REST_API_TOKEN instead; both names work.

# Force a store: redis | memory | noop
# RATE_LIMIT_STORE=

# Override the per-IP ceiling per hour (production default 5000).
# API_RATE_LIMIT_MAX=

# IndexNow (scripts/indexnow.mjs, run by .github/workflows/indexnow.yml after
# each production deploy). Must match public/<key>.txt; CI reads it from the
# INDEXNOW_KEY repository variable.
# INDEXNOW_KEY=a1fbc0b7b06d770bd3e5de37cb844472
