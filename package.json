{
  "name": "syntaqx.com",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/git-history.mjs && shadcn build && next build && node scripts/pagefind.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dwg": "node scripts/dwg/build.mjs",
    "dwg:render": "node scripts/dwg/render.mjs",
    "links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-doc-links.mjs",
    "gaps": "node scripts/source-gaps.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "resume:pdf": "esbuild scripts/resume-pdf.mts --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=.private/resume-pdf.mjs --log-level=warning && node .private/resume-pdf.mjs",
    "registry": "shadcn build",
    "registry:upstream": "node scripts/registry-upstream.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.10.0",
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@toon-format/toon": "^4.4.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "fflate": "^0.8.3",
    "javascript-obfuscator": "^5.9.1",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "simple-icons": "^16.36.0",
    "smol-toml": "^1.9.1",
    "tailwind-merge": "^3.7.0",
    "terser": "^5.51.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "pagefind": "^1.6.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unpdf": "^2.1.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "esbuild": "$esbuild",
    "@eslint/eslintrc": {
      "js-yaml": "^4.3.2"
    },
    "postcss-selector-parser": "^7.1.6",
    "@sentry/bundler-plugins": {
      "glob": "^14.0.2"
    },
    "minimatch@^10.0.0": "^11.0.1",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
